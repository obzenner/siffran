{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://siffran.dev/contracts/empirica/v2/host-boundaries.schema.json",
  "title": "Empirica v2 host-boundary registry",
  "description": "The boundaries between Empirica and its hosts, the expectations that hold at each, and the falsifiable scenarios that prove them (ADR-0068). Each scenario is covered by named tests, or is live-only and names a native-qualification ledger row.",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "title", "authority", "design_document", "ledger", "control_modes", "boundaries", "expectations", "scenarios"],
  "properties": {
    "protocol": {"const": "empirica/v2"},
    "title": {"type": "string", "minLength": 1},
    "authority": {"type": "string", "minLength": 1},
    "design_document": {"type": "string", "pattern": "^[^/].*\\.md$"},
    "ledger": {"type": "string", "pattern": "^[^/].*\\.md$"},
    "control_modes": {
      "description": "The closed control-mode axis: deliberative; interactive auto before and after its first approval; delegated auto.",
      "const": ["deliberative", "auto-interactive-pre", "auto-interactive-post", "auto-delegated"]
    },
    "boundaries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name"],
        "properties": {
          "id": {"type": "string", "pattern": "^HB-[A-Z]+(-[A-Z]+)?$"},
          "name": {"type": "string", "minLength": 1}
        }
      }
    },
    "expectations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "boundary", "title", "control_mode_dependent", "outcomes", "scenarios", "sources"],
        "properties": {
          "id": {"type": "string", "pattern": "^HX-[A-Z]+-[0-9]{2}$"},
          "boundary": {"type": "string", "pattern": "^HB-[A-Z]+(-[A-Z]+)?$"},
          "title": {"type": "string", "minLength": 1},
          "control_mode_dependent": {"type": "boolean"},
          "outcomes": {"type": "string", "minLength": 1},
          "outcomes_by_mode": {"type": "string", "minLength": 1},
          "scenarios": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^EHB-[A-Z]+-[0-9]{2}$"}, "uniqueItems": true},
          "sources": {"type": "string", "minLength": 1}
        },
        "if": {"properties": {"control_mode_dependent": {"const": true}}},
        "then": {"required": ["outcomes_by_mode"]}
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "boundary", "control_modes", "setup", "action", "expected", "covered_by", "ledger_rows"],
        "properties": {
          "id": {"description": "Permanent and never reused. The prefix names the family of the scenario, not necessarily the boundary it is filed under (EHB-TOOL-04 is filed under HB-RESULT, EHB-INT-04 under HB-AUD-RES).", "type": "string", "pattern": "^EHB-[A-Z]+-[0-9]{2}$"},
          "boundary": {"type": "string", "pattern": "^HB-[A-Z]+(-[A-Z]+)?$"},
          "control_modes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"enum": ["any", "deliberative", "auto-interactive-pre", "auto-interactive-post", "auto-delegated"]}
          },
          "setup": {"type": "string", "minLength": 1},
          "action": {"type": "string", "minLength": 1},
          "expected": {"type": "string", "minLength": 1},
          "covered_by": {
            "description": "Existing tests, as `<repo path>::<name or title>[::<name>…]`. Python: each part must be a def or class of that exact name, and a part after a class is looked up inside it; Node: each part must be the start of a test title; `*` stands for every test of the preceding class.",
            "type": "array",
            "items": {"type": "string", "pattern": "^[^/][^:]*::.+$"},
            "uniqueItems": true
          },
          "live_only": {
            "description": "A native-qualification ledger row (scenarios.md) that settles what no deterministic test can show: host behaviour only an operator can produce.",
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "ledger_rows": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}, "uniqueItems": true}
        },
        "anyOf": [
          {"properties": {"covered_by": {"minItems": 1}}},
          {"required": ["live_only"]}
        ]
      }
    }
  }
}
