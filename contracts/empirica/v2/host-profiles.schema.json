{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://siffran.dev/contracts/empirica/v2/host-profiles.schema.json",
  "title": "Empirica v2 host capability profiles",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "profiles"],
  "properties": {
    "protocol": {"const": "empirica/v2"},
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "host_id", "profile_id", "version", "current_tier",
          "required_fixture_ids", "required_live_probe_ids", "promotion_status",
          "input_private", "output_private", "unsupported_reason_ids", "sources"
        ],
        "properties": {
          "host_id": {"type": "string", "minLength": 1},
          "profile_id": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "current_tier": {"enum": ["full_async", "foreground_only", "observational"]},
          "candidate_tier": {"enum": ["full_async", "foreground_only", "observational"]},
          "candidate_probe_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "required_fixture_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "required_live_probe_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "promotion_status": {"enum": ["pending_live", "promoted", "wip_unsupported"]},
          "input_private": {"oneOf": [{"type": "boolean"}, {"const": "unverified"}]},
          "output_private": {"oneOf": [{"type": "boolean"}, {"const": "unverified"}]},
          "unsupported_reason_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "sources": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true}
        },
        "dependentRequired": {
          "candidate_tier": ["candidate_probe_ids"]
        },
        "allOf": [
          {
            "if": {"properties": {"promotion_status": {"const": "wip_unsupported"}}},
            "then": {
              "required": ["candidate_tier", "candidate_probe_ids"],
              "properties": {"current_tier": {"const": "observational"}}
            }
          },
          {
            "if": {"properties": {"promotion_status": {"const": "promoted"}}},
            "then": {"properties": {"current_tier": {"enum": ["full_async", "foreground_only"]}}}
          }
        ]
      }
    }
  }
}
