{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://siffran.dev/contracts/empirica/v2/host-profiles.schema.json",
  "title": "Empirica v2 host capability profiles",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "thinking_levels", "profiles"],
  "properties": {
    "protocol": {"const": "empirica/v2"},
    "thinking_levels": {
      "description": "The exact reasoning-level suffixes a host appends to a model spelling as ':<level>' (Pi: pi-subagents' THINKING_LEVELS). Identity observers strip precisely these, never a generic ':<anything>' suffix.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z]+$"}
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "host_id", "profile_id", "version", "compatibility", "current_tier", "audit_execution",
          "required_fixture_ids", "required_live_probe_ids", "promotion_status",
          "input_private", "output_private", "unsupported_reason_ids", "sources",
          "delegation_env", "approval_ingress"
        ],
        "properties": {
          "host_id": {"type": "string", "minLength": 1},
          "profile_id": {"description": "The host family, plus `+<policy_id>` for a foreground-audit host. Never a version: the qualified version is `version`, the interval is `compatibility`, and the observed version is on `host_runtime` and on every receipt.", "type": "string", "minLength": 1},
          "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
          "compatibility": {
            "type": "object",
            "additionalProperties": false,
            "required": ["minimum", "maximum_exclusive"],
            "properties": {
              "minimum": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
              "maximum_exclusive": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
            }
          },
          "current_tier": {"enum": ["full_async", "foreground_only", "observational"]},
          "audit_execution": {"enum": ["async", "foreground", "unavailable"]},
          "candidate_tier": {"enum": ["full_async", "foreground_only", "observational"]},
          "candidate_probe_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "required_fixture_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "required_live_probe_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "promotion_status": {"enum": ["pending_live", "promoted", "wip_unsupported"]},
          "input_private": {"oneOf": [{"type": "boolean"}, {"const": "unverified"}]},
          "output_private": {"oneOf": [{"type": "boolean"}, {"const": "unverified"}]},
          "unsupported_reason_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "sources": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
          "delegation_env": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"},
          "approval_ingress": {"enum": ["unavailable", "mcp_elicitation", "pi_ui"]},
          "subagents_compatibility": {
            "description": "The external runtime that executes a foreground audit (Empirica 4.1 D5/D6, ADR-0069): the package, the version range it may be admitted in, and the policy identifier that names the audit bound and launch classification. Inside the range a version is admitted by what the adapter observes of it (the live launch preflight and the tool's own parameter schema), not by a list; a version with a checked-in compat record is reviewed, any other is recorded as not reviewed. profile_id is '<host_id>+<policy_id>'.",
            "type": "object",
            "additionalProperties": false,
            "required": ["package", "policy_id", "minimum", "maximum_exclusive"],
            "properties": {
              "package": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
              "policy_id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*-v[0-9]+$"},
              "minimum": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
              "maximum_exclusive": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
            }
          },
          "audit_launch_policy": {
            "description": "The bounds the host adapter injects into every foreground audit launch (Empirica 4.1 D3): a wall-clock timeout and a tool budget. Turn counts are deliberately not bounded. tool_budget.block lists the tools stopped once the hard budget is spent; it lists the tools that spend budget (the file tools); contact_supervisor writes nothing and is not budgeted, so it is in audit_child_tools and not here. audit_child_tools is the only set of tools the auditor child may be given: the launch preflight's effective allowlist must be a subset of it, or the audit is refused at start and at launch (ADR-0069). It holds the read-only tools plus contact_supervisor (validate_contracts.py closes the vocabulary), which writes nothing and which the blocked author cannot answer in a foreground audit.",
            "type": "object",
            "additionalProperties": false,
            "required": ["timeout_ms", "audit_child_tools", "tool_budget"],
            "properties": {
              "timeout_ms": {"type": "integer", "minimum": 1, "maximum": 2147483647},
              "audit_child_tools": {"type": "array", "minItems": 1, "uniqueItems": true,
                                    "items": {"type": "string", "minLength": 1}},
              "tool_budget": {
                "type": "object",
                "additionalProperties": false,
                "required": ["soft", "hard", "block"],
                "properties": {
                  "soft": {"type": "integer", "minimum": 1},
                  "hard": {"type": "integer", "minimum": 1},
                  "block": {"type": "array", "minItems": 1, "uniqueItems": true,
                            "items": {"type": "string", "minLength": 1}}
                }
              }
            }
          }
        },
        "dependentRequired": {
          "candidate_tier": ["candidate_probe_ids"]
        },
        "allOf": [
          {
            "if": {"properties": {"promotion_status": {"const": "wip_unsupported"}}},
            "then": {
              "required": ["candidate_tier", "candidate_probe_ids"],
              "properties": {
                "current_tier": {"const": "observational"},
                "audit_execution": {"const": "unavailable"}
              }
            }
          },
          {
            "if": {"properties": {"promotion_status": {"const": "promoted"}}},
            "then": {"properties": {
              "current_tier": {"enum": ["full_async", "foreground_only"]},
              "audit_execution": {"enum": ["async", "foreground"]}
            }}
          }
        ]
      }
    }
  }
}
