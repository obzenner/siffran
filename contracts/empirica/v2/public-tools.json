{
  "protocol": "empirica/v2",
  "definitions": {
    "empirica_read": {
      "title": "Read Empirica state",
      "description": "Read Empirica state. GetRun and RestoreRun return a deterministic plain-text author view; act on its reasons, obligations, and rendered next calls rather than parsing JSON. GetArgument and GetContract retain their detailed auditor/contract sections. Inspect state after an uncertain configure_run outcome. Do not blindly reopen host UI."
    },
    "empirica_observe": {
      "title": "Record an Empirica author action",
      "description": "Submit exactly one public author action. The result is a deterministic plain-text author view; follow its rendered reasons and next calls rather than parsing JSON. Normal bootstrap is route, graph, configure_run, then investigate after approval. Graph may precede route and needs no prior investigation. configure_run requires a selected graph and requests host mediation without self-approval. Host-owned lifecycle facts are not author actions."
    },
    "report_convergence": {
      "title": "Request an Empirica decision",
      "description": "Request guarded convergence or an honest residual stop. The deterministic plain-text result renders current recovery calls; follow it rather than parsing JSON. Current obligations and audit gates remain authoritative. Human waiting is neither investigation nor convergence."
    }
  },
  "bootstrap_actions": {
    "route": {
      "description": "Record the chosen reasoning route before investigation; graph declaration may occur first.",
      "example": {
        "kind": "route",
        "reason": "Primary empirical route for the supplied goal."
      },
      "operation": "route"
    },
    "graph": {
      "description": "Propose claims and unknowns from supplied context. No repository investigation or evidence is required.",
      "example": {
        "kind": "graph",
        "payload": {
          "root": "C0",
          "claims": [
            {
              "id": "C0",
              "text": "The supplied goal can be achieved safely.",
              "gating": true,
              "kind": "ordinary"
            },
            {
              "id": "C1",
              "text": "The chosen approach fits the existing architecture.",
              "gating": true,
              "kind": "needs-decision"
            }
          ],
          "edges": [
            {
              "from": "C0",
              "to": "C1",
              "type": "SupportedBy"
            }
          ]
        }
      },
      "operation": "graph"
    },
    "configure_run": {
      "description": "After a graph exists, propose a task-sized configuration (all three ceilings plus a nonblank rationale) and request host-mediated approval before investigation in both control modes. It never self-approves or changes effective budgets before consent.",
      "example": {
        "kind": "configure_run",
        "budgets": {
          "max_passes": 5,
          "max_spawns": 1,
          "max_audit_spawns": 2
        },
        "rationale": "Five gating claims, two needing experiments; one audit plus one retry."
      },
      "operation": "configure_run"
    },
    "investigate": {
      "description": "Record the first investigation witness only after route and exact current host approval.",
      "example": {
        "kind": "investigate"
      },
      "operation": "investigate"
    }
  },
  "evidence_actions": [
    "research",
    "spike_request"
  ],
  "governance_decisions": {
    "actions": {
      "approve": {
        "unchanged_outcome": "approve",
        "changed_outcome": "amend"
      },
      "edit": {
        "unchanged_outcome": "dismiss",
        "changed_outcome": "amend"
      },
      "reject": {
        "unchanged_outcome": "reject",
        "changed_outcome": "reject"
      }
    },
    "controls": {
      "rationale_label": "Agent sizing rationale \u2014 unverified",
      "amendment_warning": "Written for the original proposal; not regenerated for these human-edited values",
      "budgets": {
        "max_passes": {
          "label": "Investigation passes",
          "maximum": 1024,
          "short": "passes",
          "help": "Passes the run may use"
        },
        "max_spawns": {
          "label": "Child spawns",
          "maximum": 128,
          "short": "spawns",
          "help": "Non-audit child agents"
        },
        "max_audit_spawns": {
          "label": "Audit spawns",
          "maximum": 128,
          "short": "audits",
          "help": "Independent auditor launches"
        }
      }
    },
    "confirmation": {
      "actions": [
        "approve",
        "decline"
      ]
    },
    "human_wait_notice": "Empirica is paused for human governance input, not converged. Investigation remains blocked; no approval was granted by this pause.",
    "recovery_exclusions": {
      "deliberative": [],
      "auto": [
        "budget.raise"
      ]
    }
  },
  "host_profiles": {
    "claude-code@2.1.278": {
      "delegation_env": "EMPIRICA_AUTO_DELEGATION"
    },
    "codex-cli@0.146.0": {
      "delegation_env": "EMPIRICA_AUTO_DELEGATION"
    },
    "pi@0.84.1+pi-subagents@0.50.0": {
      "delegation_env": "EMPIRICA_AUTO_DELEGATION"
    }
  },
  "start_refusal_codes": [
    "governance.auto_invocation_required",
    "governance.budget_contradictory",
    "run.goal_required"
  ],
  "recovery": {
    "graph.missing": {
      "message": "No selected argument graph. Propose one from supplied context before configure_run; investigation and evidence are not prerequisites.",
      "sections": [
        "claims/graph"
      ],
      "next_actions": [
        "graph.record"
      ]
    },
    "governance.approval_unavailable": {
      "message": "Host approval UI unavailable/cancelled. Keep pending; use supported UI or start an explicitly auto fresh run.",
      "sections": [
        "governance"
      ],
      "next_actions": [
        "host.repair_context",
        "residual.accept"
      ]
    },
    "governance.stale_proposal": {
      "message": "Decision is bound to a different run/revision/digest. Inspect current proposal and request a new decision.",
      "sections": [
        "governance"
      ],
      "next_actions": [
        "governance.propose",
        "residual.accept"
      ]
    },
    "governance.interaction_limit": {
      "message": "The durable proposal (3) or total (128) interaction limit is exhausted. Stop honestly or start a fresh run.",
      "sections": [
        "governance"
      ],
      "next_actions": [
        "governance.propose",
        "residual.accept"
      ]
    },
    "governance.decision_conflict": {
      "message": "The submitted control and fields conflict. Nothing was approved; use one explicit decision path.",
      "sections": [
        "governance"
      ],
      "next_actions": [
        "governance.propose"
      ]
    }
  },
