{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://siffran.dev/contracts/empirica/v2/request.schema.json",
  "title": "Empirica v2 request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "request_id",
    "command"
  ],
  "properties": {
    "protocol": {
      "const": "empirica/v2"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "command": {
      "oneOf": [
        {
          "$ref": "#/$defs/startRun"
        },
        {
          "$ref": "#/$defs/resolveRun"
        },
        {
          "$ref": "#/$defs/observeAction"
        },
        {
          "$ref": "#/$defs/evaluateRun"
        },
        {
          "$ref": "#/$defs/getRun"
        },
        {
          "$ref": "#/$defs/getArgument"
        },
        {
          "$ref": "#/$defs/getContract"
        },
        {
          "$ref": "#/$defs/restoreRun"
        }
      ]
    }
  },
  "$defs": {
    "runSelector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project",
        "session"
      ],
      "properties": {
        "project": {
          "type": "string",
          "minLength": 1
        },
        "session": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_passes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "max_spawns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 128
        },
        "max_audit_spawns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 128
        }
      }
    },
    "invocationProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "interactive",
        "signal",
        "delegation",
        "audit_retrieval",
        "human_surface"
      ],
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1
        },
        "interactive": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "signal": {
          "type": "string",
          "minLength": 1
        },
        "delegation": {
          "type": "boolean"
        },
        "host_runtime": {
          "description": "Optional host-observed facts about the runtime that executes this host's foreground audit, recorded once with the run (Pi: the pi-subagents owner). Validated at the application boundary against the host profile's subagents_compatibility range, persisted opaquely, and read by the core only for `reviewed` (a version with no checked-in compat record is recorded `reviewed: false` and shown in the run view; it is admitted by what the adapter observed of it, ADR-0069).",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "policy_id",
            "subagents"
          ],
          "properties": {
            "policy_id": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*-v[0-9]+$"
            },
            "subagents": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "package",
                "version",
                "owner_path",
                "package_root",
                "preflight_path",
                "source"
              ],
              "properties": {
                "package": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9._-]*$"
                },
                "version": {
                  "type": "string",
                  "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
                },
                "owner_path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "package_root": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "preflight_path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "source": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "reviewed": {
                  "type": "boolean",
                  "description": "Whether this exact version has a checked-in compat record. false is admitted when the live preflight and the tool's parameter schema passed; it is never a refusal by itself. An absent value reads as false (not reviewed); a present value that is not a boolean is malformed."
                }
              }
            }
          }
        },
        "session": {
          "description": "Optional host-observed fact: where this run's session can be found again, recorded once at StartRun by the host from what it observed (Claude: the hook payload's session_id and transcript_path; Pi: the session manager's id and session file). The author has no StartRun and cannot supply or change it. Absent when the host observed nothing: it reads as unknown, never as a guess.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label",
            "locator"
          ],
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "description": "A short human name for the session (its id)."
            },
            "locator": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "description": "A copyable path or id that finds the session again: its transcript or session file when the host has one, otherwise its id."
            }
          }
        },
        "audit_retrieval": {
          "description": "The retrieval kinds this host's auditor is observed to cover, recorded once at StartRun and re-observed at audit launch (a divergence refuses the launch). workspace: files inside the workspace; local: absolute or home paths; web: http(s) URLs. A research record of any other kind is confirmed by a human (ADR-0067).",
          "type": "array",
          "items": {
            "enum": [
              "local",
              "web",
              "workspace"
            ]
          },
          "uniqueItems": true
        },
        "human_surface": {
          "description": "Whether the host last observed a surface to show a dialog to a human now: Claude form elicitation advertised by the client, Pi `ctx.hasUI` in the TUI or RPC. Recorded at StartRun and updated by the host's private ingress at every report_convergence. `unobserved` means the host has not yet looked (Claude's start hook runs before the MCP client declares form elicitation); a host that can tell at start records `human` or `unavailable` at once. Evidence is presented to a human only when this is `human`, the run is not delegated or non-interactive, and the profile has a human approval ingress (ADR-0067); while it is `unobserved` such a run is told a human is asked when it reports, if the host can show a dialog.",
          "enum": [
            "human",
            "unavailable",
            "unobserved"
          ]
        }
      }
    },
    "trustedEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_ref",
        "boundary"
      ],
      "description": "Trusted-boundary capability reference. capability_ref is an opaque host/application-held reference, never a secret; committed examples redact it.",
      "properties": {
        "capability_ref": {
          "type": "string",
          "minLength": 1
        },
        "boundary": {
          "enum": [
            "host",
            "application"
          ]
        }
      }
    },
    "payload": {
      "type": "object",
      "description": "Extensible deep evidence/actor domain data; only this object may carry D6-validated payload. The control object itself is closed."
    },
    "researchPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_ref",
        "citation"
      ],
      "properties": {
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "citation": {
          "type": "string",
          "minLength": 1
        },
        "observed_content_digest": {
          "$ref": "#/$defs/digest256"
        },
        "spike_unavailable": {
          "type": "string",
          "minLength": 1,
          "description": "Required for a runtime record whose source_ref is neither a workspace path nor a URL or absolute path: why no deterministic spike can establish the observation. Shown to the human verbatim."
        }
      }
    },
    "digest256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "nullableDigest256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "relativePosixPath": {
      "type": "string",
      "minLength": 1,
      "description": "Strict normalized repo-relative POSIX path shared with the response schema; rejects leading slash, drive/colon prefix, backslash/UNC, empty/repeated separator, and dot/dotdot segments.",
      "pattern": "^(?!(?:\\.(?:/|$)))(?!(?:\\.\\.(?:/|$)))(?!.*/\\.(?:/|$))(?!.*/\\.\\.(?:/|$))[^\\\\/:]+(?:/[^\\\\/:]+)*$"
    },
    "fileBindingRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "description": "Closed file result binding for a trusted evidence_leaf; path is a strict normalized repo-relative POSIX path and sha256 is a digest256.",
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePosixPath"
        },
        "sha256": {
          "$ref": "#/$defs/digest256"
        }
      }
    },
    "reviewedClaimItemRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "evidence_digest"
      ],
      "description": "Closed reviewed-claim item for a trusted audit_verdict payload.",
      "properties": {
        "claim_id": {
          "$ref": "#/$defs/claimId"
        },
        "evidence_digest": {
          "$ref": "#/$defs/digest256"
        }
      }
    },
    "childEventPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "native_id",
        "fingerprint",
        "result_digest"
      ],
      "description": "Closed trusted child_event payload. state is a canonical child state excluding reserved; native_id, fingerprint, and result_digest follow exact branch/null relations. No nested event alias.",
      "properties": {
        "state": {
          "enum": [
            "launching",
            "pending",
            "completed",
            "launch_rejected",
            "failed",
            "cancelled",
            "timed_out",
            "orphaned"
          ]
        },
        "native_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "fingerprint": {
          "$ref": "#/$defs/digest256"
        },
        "result_digest": {
          "$ref": "#/$defs/nullableDigest256"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "launching",
                  "pending",
                  "completed",
                  "failed",
                  "cancelled",
                  "timed_out",
                  "orphaned"
                ]
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "native_id": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "native_id"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "launch_rejected"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "native_id": {
                "type": "null"
              }
            },
            "required": [
              "native_id"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "completed"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "result_digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            },
            "required": [
              "result_digest"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "launching",
                  "pending",
                  "launch_rejected",
                  "failed",
                  "cancelled",
                  "timed_out",
                  "orphaned"
                ]
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "result_digest": {
                "type": "null"
              }
            },
            "required": [
              "result_digest"
            ]
          }
        }
      ]
    },
    "attributionPayload": {
      "allOf": [
        {
          "$ref": "#/$defs/identityObservation"
        },
        {
          "type": "object",
          "required": [
            "subject_kind",
            "subject_id",
            "child_id",
            "covered_artifact_ids"
          ],
          "properties": {
            "subject_kind": {
              "enum": [
                "auditor"
              ]
            },
            "subject_id": {
              "type": "string",
              "minLength": 1
            },
            "child_id": {
              "type": "string",
              "minLength": 1
            },
            "covered_artifact_ids": {
              "type": "array",
              "maxItems": 0,
              "items": {
                "$ref": "#/$defs/digest256"
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false,
      "description": "Closed trusted reviewer attribution carrying an opaque identity class plus raw provenance."
    },
    "auditVerdictPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verdict",
        "findings",
        "argument_digest",
        "goal_digest",
        "frozen_scope_digest",
        "deferred_scope_digest",
        "reviewed_claims",
        "scope_review"
      ],
      "description": "Closed trusted audit_verdict payload. frozen_scope_digest null requires scope_review null; non-null requires pass|fail. No independence/attribution/model/provider field.",
      "properties": {
        "verdict": {
          "enum": [
            "pass",
            "fail"
          ]
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "argument_digest": {
          "$ref": "#/$defs/digest256"
        },
        "goal_digest": {
          "$ref": "#/$defs/digest256"
        },
        "frozen_scope_digest": {
          "$ref": "#/$defs/nullableDigest256"
        },
        "deferred_scope_digest": {
          "$ref": "#/$defs/digest256"
        },
        "reviewed_claims": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/reviewedClaimItemRequest"
          }
        },
        "scope_review": {
          "enum": [
            "pass",
            "fail",
            null
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "frozen_scope_digest": {
                "type": "null"
              }
            },
            "required": [
              "frozen_scope_digest"
            ]
          },
          "then": {
            "properties": {
              "scope_review": {
                "type": "null"
              }
            },
            "required": [
              "scope_review"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "frozen_scope_digest": {
                "type": "string"
              }
            },
            "required": [
              "frozen_scope_digest"
            ]
          },
          "then": {
            "properties": {
              "scope_review": {
                "enum": [
                  "pass",
                  "fail"
                ]
              }
            },
            "required": [
              "scope_review"
            ]
          }
        }
      ]
    },
    "evidenceLeafPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "harness_request_id",
        "request_artifact_id",
        "plan_digest",
        "policy_digest",
        "snapshot_digest",
        "prerequisite_research_ids",
        "file_bindings",
        "exit_code",
        "result_digest"
      ],
      "description": "Closed trusted evidence_leaf payload correlated to one admitted generic request and result artifact.",
      "properties": {
        "harness_request_id": {
          "$ref": "#/$defs/digest256"
        },
        "prerequisite_research_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/digest256"
          }
        },
        "file_bindings": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "description": "Closed file result bindings for a trusted evidence_leaf. uniqueItems rejects identical {path,sha256} objects; procedural validation additionally rejects duplicate normalized path even when hashes differ.",
          "items": {
            "$ref": "#/$defs/fileBindingRequest"
          }
        },
        "exit_code": {
          "type": "integer"
        },
        "result_digest": {
          "$ref": "#/$defs/digest256"
        },
        "request_artifact_id": {
          "$ref": "#/$defs/digest256"
        },
        "plan_digest": {
          "$ref": "#/$defs/digest256"
        },
        "policy_digest": {
          "$ref": "#/$defs/digest256"
        },
        "snapshot_digest": {
          "$ref": "#/$defs/digest256"
        }
      }
    },
    "actionGraph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "graph"
        },
        "payload": {
          "$ref": "#/$defs/graphPayload"
        }
      }
    },
    "actionResearch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "claim_id",
        "source_kind",
        "result",
        "payload"
      ],
      "properties": {
        "kind": {
          "const": "research"
        },
        "claim_id": {
          "$ref": "#/$defs/claimId"
        },
        "source_kind": {
          "enum": [
            "docs",
            "code",
            "runtime",
            "web"
          ]
        },
        "result": {
          "enum": [
            "supports",
            "refutes"
          ]
        },
        "payload": {
          "$ref": "#/$defs/researchPayload"
        }
      }
    },
    "actionSpikeRequest": {
      "description": "Request one closed generic deterministic spike plan draft for a run whose exact generic Docker backend is bound. The profile and framework policy are host-owned and cannot be authored.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "claim_id",
        "plan"
      ],
      "properties": {
        "kind": {
          "const": "spike_request"
        },
        "claim_id": {
          "$ref": "#/$defs/claimId"
        },
        "plan": {
          "$ref": "#/$defs/spikePlanDraft"
        }
      }
    },
    "actionConfigureRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "budgets",
        "rationale"
      ],
      "properties": {
        "kind": {
          "const": "configure_run"
        },
        "budgets": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_passes",
            "max_spawns",
            "max_audit_spawns"
          ],
          "properties": {
            "max_passes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1024
            },
            "max_spawns": {
              "type": "integer",
              "minimum": 0,
              "maximum": 128
            },
            "max_audit_spawns": {
              "type": "integer",
              "minimum": 0,
              "maximum": 128
            }
          }
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600,
          "pattern": "\\S",
          "description": "Nonblank author sizing rationale bound by the proposal digest; not a command, authority claim, or approvable conclusion."
        }
      }
    },
    "actionRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "reason"
      ],
      "properties": {
        "kind": {
          "const": "route"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "actionInvestigate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "investigate"
        }
      }
    },
    "actionFreeze": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "freeze"
        }
      }
    },
    "actionChildReserve": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "resource_class": {
                "const": "audit"
              }
            }
          },
          "then": {
            "properties": {
              "purpose": {
                "const": "audit"
              }
            }
          }
        }
      ],
      "required": [
        "kind",
        "purpose",
        "role_profile",
        "execution",
        "resource_class"
      ],
      "properties": {
        "kind": {
          "const": "child_reserve"
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "role_profile": {
          "type": "string",
          "minLength": 1
        },
        "execution": {
          "enum": [
            "foreground",
            "async"
          ]
        },
        "resource_class": {
          "enum": [
            "investigation",
            "audit"
          ]
        },
        "deadline": {
          "type": [
            "string",
            "null"
          ]
        },
        "auditor_identity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "actionEvidenceLeaf": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "trusted",
        "payload"
      ],
      "properties": {
        "kind": {
          "const": "evidence_leaf"
        },
        "trusted": {
          "$ref": "#/$defs/trustedEnvelope"
        },
        "payload": {
          "$ref": "#/$defs/evidenceLeafPayload"
        }
      }
    },
    "actionAttribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "trusted",
        "payload"
      ],
      "properties": {
        "kind": {
          "const": "attribution"
        },
        "trusted": {
          "$ref": "#/$defs/trustedEnvelope"
        },
        "payload": {
          "$ref": "#/$defs/attributionPayload"
        }
      }
    },
    "actionChildEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "trusted",
        "child_id",
        "payload"
      ],
      "properties": {
        "kind": {
          "const": "child_event"
        },
        "trusted": {
          "$ref": "#/$defs/trustedEnvelope"
        },
        "child_id": {
          "type": "string",
          "minLength": 1
        },
        "payload": {
          "$ref": "#/$defs/childEventPayload"
        }
      }
    },
    "actionAuditVerdict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "trusted",
        "child_id",
        "payload"
      ],
      "properties": {
        "kind": {
          "const": "audit_verdict"
        },
        "trusted": {
          "$ref": "#/$defs/trustedEnvelope"
        },
        "child_id": {
          "type": "string",
          "minLength": 1
        },
        "payload": {
          "$ref": "#/$defs/auditVerdictPayload"
        }
      }
    },
    "action": {
      "oneOf": [
        {
          "$ref": "#/$defs/actionGraph"
        },
        {
          "$ref": "#/$defs/actionResearch"
        },
        {
          "$ref": "#/$defs/actionSpikeRequest"
        },
        {
          "$ref": "#/$defs/actionConfigureRun"
        },
        {
          "$ref": "#/$defs/actionRoute"
        },
        {
          "$ref": "#/$defs/actionInvestigate"
        },
        {
          "$ref": "#/$defs/actionFreeze"
        },
        {
          "$ref": "#/$defs/actionChildReserve"
        },
        {
          "$ref": "#/$defs/actionEvidenceLeaf"
        },
        {
          "$ref": "#/$defs/actionAttribution"
        },
        {
          "$ref": "#/$defs/actionChildEvent"
        },
        {
          "$ref": "#/$defs/actionAuditVerdict"
        }
      ]
    },
    "startRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "selector",
        "goal",
        "invocation",
        "control_mode"
      ],
      "properties": {
        "type": {
          "const": "StartRun"
        },
        "selector": {
          "$ref": "#/$defs/runSelector"
        },
        "goal": {
          "type": "string",
          "maxLength": 4096,
          "description": "Blank goals are refused with run.goal_required."
        },
        "invocation": {
          "$ref": "#/$defs/invocationProvenance"
        },
        "budgets": {
          "$ref": "#/$defs/budgets"
        },
        "control_mode": {
          "enum": [
            "deliberative",
            "auto"
          ]
        },
        "spike_profile": {
          "enum": [
            "docker-isolated-v1",
            "docker-networked-v1"
          ],
          "description": "Optional host-owned generic Docker profile selection; never author action data."
        }
      }
    },
    "resolveRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "selector"
      ],
      "properties": {
        "type": {
          "const": "ResolveRun"
        },
        "selector": {
          "$ref": "#/$defs/runSelector"
        }
      }
    },
    "observeAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "run_id",
        "action"
      ],
      "properties": {
        "type": {
          "const": "ObserveAction"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "$ref": "#/$defs/action"
        },
        "observed_at": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "evaluateRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "run_id",
        "intent"
      ],
      "properties": {
        "type": {
          "const": "EvaluateRun"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "intent": {
          "enum": [
            "continue",
            "report_convergence",
            "stop"
          ]
        },
        "observed_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "host_failure": {
          "description": "What the host reports about this call when it could not do the mediation a report asks of it: surface_unrecorded (it could not record whether a human can be asked) or presentation_failed (it could not show the pending batch). Nobody was asked. The core projects it as the batch's prompt_error, never stores it, and spends and approves nothing; a refusal it already knows (already_presented, interaction_limit, unavailable) takes precedence.",
          "enum": [
            "surface_unrecorded",
            "presentation_failed"
          ]
        }
      }
    },
    "getRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "run_id"
      ],
      "properties": {
        "type": {
          "const": "GetRun"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "getArgument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "run_id"
      ],
      "properties": {
        "type": {
          "const": "GetArgument"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "getContract": {
      "oneOf": [
        {
          "$ref": "#/$defs/getContractIndex"
        },
        {
          "$ref": "#/$defs/getContractSection"
        }
      ]
    },
    "restoreRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "run_id"
      ],
      "properties": {
        "type": {
          "const": "RestoreRun"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "getContractIndex": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "target"
      ],
      "properties": {
        "type": {
          "const": "GetContract"
        },
        "target": {
          "const": "index"
        }
      }
    },
    "getContractSection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "target",
        "section_id"
      ],
      "properties": {
        "type": {
          "const": "GetContract"
        },
        "target": {
          "const": "section"
        },
        "section_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "governanceContextPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "author",
        "ingress"
      ],
      "properties": {
        "author": {
          "anyOf": [
            {
              "$ref": "#/$defs/identityObservation",
              "unevaluatedProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "ingress": {
          "enum": [
            "unavailable",
            "mcp_elicitation",
            "pi_ui"
          ]
        }
      }
    },
    "governanceDecisionPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "receipt_id",
        "proposal_digest",
        "plan_revision",
        "approval_kind"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "receipt_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "proposal_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "plan_revision": {
          "type": "integer",
          "minimum": 0
        },
        "approval_kind": {
          "enum": [
            "auto",
            "host_ui"
          ]
        },
        "outcome": {
          "enum": [
            "approve",
            "amend",
            "reject",
            "dismiss",
            "present"
          ]
        },
        "amendment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "budgets"
          ],
          "properties": {
            "budgets": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "max_passes",
                "max_spawns",
                "max_audit_spawns"
              ],
              "properties": {
                "max_passes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1024
                },
                "max_spawns": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 128
                },
                "max_audit_spawns": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 128
                }
              }
            }
          }
        },
        "submission": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "configuration"
          ],
          "properties": {
            "action": {
              "enum": [
                "approve",
                "edit",
                "reject"
              ]
            },
            "configuration": {
              "$ref": "#/$defs/governanceDecisionPayload/properties/amendment"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "amend"
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "required": [
              "amendment"
            ]
          },
          "else": {
            "not": {
              "required": [
                "amendment"
              ]
            }
          }
        }
      ],
      "oneOf": [
        {
          "required": [
            "outcome"
          ],
          "not": {
            "required": [
              "submission"
            ]
          }
        },
        {
          "required": [
            "submission"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "outcome"
                ]
              },
              {
                "required": [
                  "amendment"
                ]
              }
            ]
          }
        }
      ]
    },
    "identityObservation": {
      "type": "object",
      "required": [
        "identity",
        "provider_id",
        "model_id",
        "policy_version",
        "source",
        "observed_by"
      ],
      "properties": {
        "identity": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "provider_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 256
        },
        "model_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 512
        },
        "policy_version": {
          "const": "model-identity/1"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "observed_by": {
          "const": "host"
        }
      },
      "description": "Open only for allOf extension; every direct $ref use must set unevaluatedProperties: false."
    },
    "graphClaimItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "kind",
        "gating"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/claimId"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "kind": {
          "enum": [
            "ordinary",
            "needs-experiment",
            "needs-decision"
          ]
        },
        "gating": {
          "type": "boolean"
        }
      },
      "description": "Closed author-supplied claim vertex for a graph action; matches core.evaluation.valid_graph. Uniqueness, root membership, acyclicity and reachability stay core-only."
    },
    "graphEdgeItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "type"
      ],
      "properties": {
        "from": {
          "$ref": "#/$defs/claimId"
        },
        "to": {
          "$ref": "#/$defs/claimId"
        },
        "type": {
          "const": "SupportedBy"
        }
      },
      "description": "Closed author-supplied support edge for a graph action."
    },
    "graphPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "claims",
        "edges"
      ],
      "properties": {
        "root": {
          "$ref": "#/$defs/claimId"
        },
        "claims": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/graphClaimItem"
          }
        },
        "edges": {
          "type": "array",
          "minItems": 0,
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/graphEdgeItem"
          }
        }
      },
      "description": "Closed graph action payload owned by the SSOT and projected into the model-facing tool schema. Defence in depth; core.evaluation.valid_graph remains authoritative."
    },
    "claimId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}(?![\\s\\S])"
    },
    "evidenceConfirmationPayload": {
      "description": "One human receipt of per-item decisions on the batch a presentation showed. The receipt id is the presentation's; it is admitted only while the pending set is unchanged since. Omitted items stay pending. Admitted only through the run's human approval ingress.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "receipt_id",
        "decisions"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "receipt_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "decisions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "subject",
                  "artifact_id",
                  "outcome"
                ],
                "properties": {
                  "subject": {
                    "const": "research"
                  },
                  "artifact_id": {
                    "$ref": "#/$defs/digest256"
                  },
                  "outcome": {
                    "enum": [
                      "confirm",
                      "reject"
                    ]
                  },
                  "note": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "subject",
                  "claim_id",
                  "claim_digest",
                  "outcome"
                ],
                "properties": {
                  "subject": {
                    "const": "claim"
                  },
                  "claim_id": {
                    "$ref": "#/$defs/claimId"
                  },
                  "claim_digest": {
                    "$ref": "#/$defs/digest256"
                  },
                  "outcome": {
                    "enum": [
                      "approve",
                      "reject"
                    ]
                  },
                  "answer": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  }
                }
              }
            ]
          }
        }
      }
    },
    "evidencePresentationPayload": {
      "description": "The host records that it showed the human the batch it names (the run view's confirmation_batch.key), once per derivation; the receipt id names the presentation. Refused, spending nothing, when the key is not the current batch's. Spends one human interaction. Admitted only through the run's human approval ingress.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "receipt_id",
        "key"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "receipt_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "key": {
          "$ref": "#/$defs/digest256"
        }
      }
    },
    "humanSurfacePayload": {
      "description": "The host's observation of whether it can show a dialog to a human now (Claude form elicitation advertised by the client; Pi `ctx.hasUI`). Sent with every report_convergence; the latest observation counts and records invocation.human_surface.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "surface"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "surface": {
          "enum": [
            "human",
            "unavailable"
          ]
        }
      }
    },
    "spikePlanDraft": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "image",
        "argv",
        "inputs",
        "environment"
      ],
      "properties": {
        "schema": {
          "const": "empirica.spike-plan-draft/2",
          "description": "Exact minimal single-container author draft schema."
        },
        "image": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^(?!.*\\s).+$",
          "description": "Already-local Docker name/tag, repository digest, full image ID, or unambiguous ID prefix; locality and ambiguity are host-resolved."
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "prefixItems": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          ],
          "items": {
            "type": "string",
            "maxLength": 4096
          },
          "description": "Exact executable and argument vector; no shell is injected."
        },
        "inputs": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^(?!/)(?!.*\\\\)(?!.*//).+$"
          },
          "description": "Repository-relative file or directory declarations; host expansion excludes symlinks and .git and seals one canonical captured-file union."
        },
        "environment": {
          "type": "object",
          "maxProperties": 128,
          "propertyNames": {
            "allOf": [
              {
                "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"
              },
              {
                "not": {
                  "enum": [
                    "HOME",
                    "TMPDIR"
                  ]
                }
              }
            ]
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 4096
          },
          "description": "Bounded authored overrides; HOME and TMPDIR are framework-owned and values must never contain secrets."
        }
      },
      "description": "Closed single-container spike intent. The author supplies no authority, profile, resources, timeout, user, workdir, network, topology, service, alias, or Docker option."
    }
  }
}
