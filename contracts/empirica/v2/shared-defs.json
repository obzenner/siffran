{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://siffran.local/empirica/v2/shared-defs.json",
  "$defs": {
    "approvalIngress": {
      "enum": [
        "unavailable",
        "mcp_elicitation",
        "pi_ui"
      ]
    },
    "approvalCapability": {
      "enum": [
        "unavailable",
        "human_configuration"
      ]
    },
    "claimId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}(?![\\s\\S])"
    },
    "invocationProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "interactive",
        "signal",
        "delegation",
        "audit_retrieval",
        "human_surface"
      ],
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1
        },
        "interactive": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "signal": {
          "type": "string",
          "minLength": 1
        },
        "delegation": {
          "type": "boolean"
        },
        "host_runtime": {
          "description": "Optional host-observed facts about the runtime that executes this host's foreground audit, recorded once with the run (Pi: the pi-subagents owner). Validated at the application boundary against the host profile's subagents_compatibility range, persisted opaquely, and read by the core only for `reviewed` (a version with no checked-in compat record is recorded `reviewed: false` and shown in the run view; it is admitted by what the adapter observed of it, ADR-0069).",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "policy_id",
            "subagents"
          ],
          "properties": {
            "policy_id": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*-v[0-9]+$"
            },
            "subagents": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "package",
                "version",
                "owner_path",
                "package_root",
                "preflight_path",
                "source"
              ],
              "properties": {
                "package": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9._-]*$"
                },
                "version": {
                  "type": "string",
                  "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
                },
                "owner_path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "package_root": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "preflight_path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "source": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "reviewed": {
                  "type": "boolean",
                  "description": "Whether this exact version has a checked-in compat record. false is admitted when the live preflight and the tool's parameter schema passed; it is never a refusal by itself. An absent value reads as false (not reviewed); a present value that is not a boolean is malformed."
                }
              }
            }
          }
        },
        "session": {
          "description": "Optional host-observed fact: where this run's session can be found again, recorded once at StartRun by the host from what it observed (Claude: the hook payload's session_id and transcript_path; Pi: the session manager's id and session file). The author has no StartRun and cannot supply or change it. Absent when the host observed nothing: it reads as unknown, never as a guess.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label",
            "locator"
          ],
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "description": "A short human name for the session (its id)."
            },
            "locator": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "description": "A copyable path or id that finds the session again: its transcript or session file when the host has one, otherwise its id."
            }
          }
        },
        "audit_retrieval": {
          "description": "The retrieval kinds this host's auditor is observed to cover, recorded once at StartRun and re-observed at audit launch (a divergence refuses the launch). workspace: files inside the workspace; local: absolute or home paths; web: http(s) URLs. A research record of any other kind is confirmed by a human (ADR-0067).",
          "type": "array",
          "items": {
            "enum": [
              "local",
              "web",
              "workspace"
            ]
          },
          "uniqueItems": true
        },
        "human_surface": {
          "description": "Whether the host last observed a surface to show a dialog to a human now: Claude form elicitation advertised by the client, Pi `ctx.hasUI` in the TUI or RPC. Recorded at StartRun and updated by the host's private ingress at every report_convergence. `unobserved` means the host has not yet looked (Claude's start hook runs before the MCP client declares form elicitation); a host that can tell at start records `human` or `unavailable` at once. Evidence is presented to a human only when this is `human`, the run is not delegated or non-interactive, and the profile has a human approval ingress (ADR-0067); while it is `unobserved` such a run is told a human is asked when it reports, if the host can show a dialog.",
          "enum": [
            "human",
            "unavailable",
            "unobserved"
          ]
        }
      }
    },
    "identityObservation": {
      "type": "object",
      "required": [
        "identity",
        "provider_id",
        "model_id",
        "policy_version",
        "source",
        "observed_by"
      ],
      "properties": {
        "identity": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "provider_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 256
        },
        "model_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 512
        },
        "policy_version": {
          "const": "model-identity/1"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "observed_by": {
          "const": "host"
        }
      },
      "description": "Open only for allOf extension; every direct $ref use must set unevaluatedProperties: false."
    },
    "graphClaimItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "kind",
        "gating"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/claimId"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "kind": {
          "enum": [
            "ordinary",
            "needs-experiment",
            "needs-decision"
          ]
        },
        "gating": {
          "type": "boolean"
        }
      },
      "description": "Closed author-supplied claim vertex for a graph action; matches core.evaluation.valid_graph. Uniqueness, root membership, acyclicity and reachability stay core-only."
    },
    "graphEdgeItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "type"
      ],
      "properties": {
        "from": {
          "$ref": "#/$defs/claimId"
        },
        "to": {
          "$ref": "#/$defs/claimId"
        },
        "type": {
          "const": "SupportedBy"
        }
      },
      "description": "Closed author-supplied support edge for a graph action."
    },
    "graphPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "claims",
        "edges"
      ],
      "properties": {
        "root": {
          "$ref": "#/$defs/claimId"
        },
        "claims": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/graphClaimItem"
          }
        },
        "edges": {
          "type": "array",
          "minItems": 0,
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/graphEdgeItem"
          }
        }
      },
      "description": "Closed graph action payload owned by the SSOT and projected into the model-facing tool schema. Defence in depth; core.evaluation.valid_graph remains authoritative."
    },
    "spikePlanDraft": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "image",
        "argv",
        "inputs",
        "environment"
      ],
      "properties": {
        "schema": {
          "const": "empirica.spike-plan-draft/2",
          "description": "Exact minimal single-container author draft schema."
        },
        "image": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^(?!.*\\s).+$",
          "description": "Already-local Docker name/tag, repository digest, full image ID, or unambiguous ID prefix; locality and ambiguity are host-resolved."
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "prefixItems": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          ],
          "items": {
            "type": "string",
            "maxLength": 4096
          },
          "description": "Exact executable and argument vector; no shell is injected."
        },
        "inputs": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^(?!/)(?!.*\\\\)(?!.*//).+$"
          },
          "description": "Repository-relative file or directory declarations forming a bounded canonical closure: a set, accepted in any order and normalized to sorted canonical order; overlapping or duplicate-root entries (one declaration inside another, or two spellings of one root such as src and src/) are refused with invalid_request. Host expansion excludes symlinks and .git and seals one canonical captured-file union."
        },
        "environment": {
          "type": "object",
          "maxProperties": 128,
          "propertyNames": {
            "allOf": [
              {
                "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"
              },
              {
                "not": {
                  "enum": [
                    "HOME",
                    "TMPDIR"
                  ]
                }
              }
            ]
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 4096
          },
          "description": "Bounded authored overrides; HOME and TMPDIR are framework-owned and values must never contain secrets."
        }
      },
      "description": "Closed single-container spike intent. The author supplies no authority, profile, resources, timeout, user, workdir, network, topology, service, alias, or Docker option."
    },
    "projectedSpikePlanDraft": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "image", "argv", "inputs", "environment"],
      "properties": {
        "schema": {"const": "empirica.spike-plan-draft/2"},
        "image": {"type": "string", "minLength": 1, "maxLength": 255},
        "argv": {"type": "array", "minItems": 1, "maxItems": 256,
          "items": {"type": "string", "maxLength": 4096}},
        "inputs": {"type": "array", "maxItems": 256, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 1024,
            "pattern": "^(?!/)(?!.*\\\\)(?!.*//).+$"}},
        "environment": {"type": "array", "maxItems": 128, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"},
          "description": "Names only; authored values and confirmable standalone derivatives are private."}
      }
    },
    "governancePresentation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dialog",
        "scope"
      ],
      "properties": {
        "dialog": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "epoch",
            "control_mode",
            "state",
            "reviews_left",
            "goal",
            "rationale",
            "rationale_label",
            "amendment_warning",
            "invocation",
            "budgets"
          ],
          "properties": {
            "epoch": {
              "type": "integer",
              "minimum": 0
            },
            "control_mode": {
              "type": "string"
            },
            "state": {
              "type": "string"
            },
            "reviews_left": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "proposal",
                "total"
              ],
              "properties": {
                "proposal": {
                  "type": "integer",
                  "minimum": 0
                },
                "total": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "goal": {
              "type": "string"
            },
            "rationale": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 3600,
                  "pattern": "\\S"
                }
              ]
            },
            "rationale_label": {
              "type": "string",
              "minLength": 1
            },
            "amendment_warning": {
              "type": "string",
              "minLength": 1
            },
            "invocation": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/invocationProvenance"
                }
              ]
            },
            "budgets": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "key",
                  "label",
                  "short",
                  "help",
                  "value",
                  "used",
                  "minimum",
                  "maximum"
                ],
                "properties": {
                  "key": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  },
                  "short": {
                    "type": "string"
                  },
                  "help": {
                    "type": "string"
                  },
                  "value": {
                    "type": "integer"
                  },
                  "used": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "minimum": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "maximum": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          }
        },
        "scope": {
          "anyOf": [
            {
              "$ref": "#/$defs/graphPayload"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
