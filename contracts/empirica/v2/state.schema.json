{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://siffran.dev/contracts/empirica/v2/state.schema.json",
  "title": "Empirica v2 internal persisted run state",
  "description": "Internal host-neutral persisted-state schema (D6 strict-v2-subtraction section 4). Not PublicContract behavior. Closed required fields with no decoder defaults; status and child-state vocabularies are mechanically mirrored from the canonical PublicContract registry. Procedural invariants (counter bounds, stamp bounds, child_id uniqueness) are owned by the codec and the contract validator, not by this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "state_schema",
    "goal",
    "status",
    "modes",
    "budgets",
    "selected_graph_artifact_id",
    "frozen_claim_ids",
    "frozen_semantic_digest",
    "route_stamp",
    "investigation_stamp",
    "stamp_seq",
    "last_derivation_digest",
    "children",
    "committed_artifact_head_id",
    "governance"
  ],
  "properties": {
    "protocol": {
      "const": "empirica/v2"
    },
    "state_schema": {
      "const": "empirica.run/2"
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "status": {
      "enum": [
        "active",
        "converged",
        "stopped_residual",
        "stopped_frozen",
        "stopped_budget"
      ]
    },
    "modes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "multi_provider",
        "cli_exec"
      ],
      "properties": {
        "multi_provider": {
          "type": "boolean"
        },
        "cli_exec": {
          "type": "boolean"
        }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_passes",
        "passes_used",
        "max_spawns",
        "spawns_used",
        "max_audit_spawns",
        "audit_spawns_used"
      ],
      "properties": {
        "max_passes": {
          "type": "integer",
          "minimum": 1
        },
        "passes_used": {
          "type": "integer",
          "minimum": 0
        },
        "max_spawns": {
          "type": "integer",
          "minimum": 0
        },
        "spawns_used": {
          "type": "integer",
          "minimum": 0
        },
        "max_audit_spawns": {
          "type": "integer",
          "minimum": 0
        },
        "audit_spawns_used": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "selected_graph_artifact_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "frozen_claim_ids": {
      "type": [
        "null",
        "array"
      ],
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "frozen_semantic_digest": {
      "$ref": "#/$defs/nullableDigest256"
    },
    "route_stamp": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "investigation_stamp": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "stamp_seq": {
      "type": "integer",
      "minimum": 0
    },
    "last_derivation_digest": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "children": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/childRecord"
      }
    },
    "committed_artifact_head_id": {
      "$ref": "#/$defs/nullableDigest256"
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "control_mode",
        "revision_limit",
        "plan_revision",
        "revisions_used",
        "approved_digest",
        "approval_kind",
        "proposal_digest",
        "proposal",
        "context",
        "receipts",
        "change_request"
      ],
      "properties": {
        "state": {
          "enum": [
            "pending",
            "approved",
            "revision_pending",
            "rejected"
          ]
        },
        "control_mode": {
          "enum": [
            "deliberative",
            "auto"
          ]
        },
        "revision_limit": {
          "enum": [
            8,
            64
          ]
        },
        "plan_revision": {
          "type": "integer",
          "minimum": 0
        },
        "revisions_used": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "approved_digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "approval_kind": {
          "enum": [
            null,
            "host_ui",
            "auto"
          ]
        },
        "proposal_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "proposal": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "budgets",
            "modes",
            "auditor",
            "allow_same_model"
          ],
          "properties": {
            "budgets": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "max_passes",
                "max_spawns",
                "max_audit_spawns"
              ],
              "properties": {
                "max_passes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1024
                },
                "max_spawns": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 128
                },
                "max_audit_spawns": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 128
                }
              }
            },
            "modes": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "multi_provider",
                "cli_exec"
              ],
              "properties": {
                "multi_provider": {
                  "type": "boolean"
                },
                "cli_exec": {
                  "type": "boolean"
                }
              }
            },
            "auditor": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "provider_id",
                    "model_id"
                  ],
                  "properties": {
                    "provider_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "model_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    }
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "allow_same_model": {
              "type": "boolean"
            }
          }
        },
        "context": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "inventory",
            "author",
            "ingress"
          ],
          "properties": {
            "inventory": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "members",
                "source",
                "complete",
                "authorized"
              ],
              "properties": {
                "members": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "provider_id",
                      "model_id"
                    ],
                    "properties": {
                      "provider_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "model_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      }
                    }
                  },
                  "maxItems": 32,
                  "uniqueItems": true
                },
                "source": {
                  "enum": [
                    "unknown",
                    "operator_declared",
                    "pi_registry"
                  ]
                },
                "complete": {
                  "type": "boolean"
                },
                "authorized": {
                  "type": "boolean"
                }
              }
            },
            "author": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "provider_id",
                    "model_id"
                  ],
                  "properties": {
                    "provider_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "model_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    }
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "ingress": {
              "enum": [
                "unavailable",
                "mcp_elicitation",
                "pi_ui"
              ]
            }
          }
        },
        "receipts": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "fingerprint",
              "presentation_fingerprint",
              "outcome",
              "plan_revision"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "fingerprint": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "presentation_fingerprint": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "outcome": {
                "enum": [
                  "approve",
                  "amend",
                  "reject",
                  "dismiss",
                  "present",
                  "request_changes"
                ]
              },
              "plan_revision": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "change_request": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "text",
                "plan_revision",
                "proposal_digest"
              ],
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "plan_revision": {
                  "type": "integer",
                  "minimum": 0
                },
                "proposal_digest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  },
  "$defs": {
    "digest256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "childRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "child_id",
        "purpose",
        "resource_class",
        "state",
        "spent",
        "refunded",
        "deadline",
        "native_id",
        "first_terminal_fingerprint",
        "capability_ref",
        "audit_operation_id",
        "audit_argument",
        "audit_role_profile",
        "audit_auditor",
        "audit_inventory_digest"
      ],
      "properties": {
        "child_id": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "resource_class": {
          "enum": [
            "investigation",
            "audit"
          ]
        },
        "state": {
          "enum": [
            "reserved",
            "launching",
            "pending",
            "completed",
            "launch_rejected",
            "failed",
            "cancelled",
            "timed_out",
            "orphaned"
          ]
        },
        "spent": {
          "type": "boolean"
        },
        "refunded": {
          "type": "boolean"
        },
        "deadline": {
          "type": [
            "number",
            "null"
          ]
        },
        "native_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "first_terminal_fingerprint": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "capability_ref": {
          "type": "string",
          "minLength": 1
        },
        "audit_operation_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/digest256"
            },
            {
              "type": "null"
            }
          ]
        },
        "audit_argument": {
          "type": [
            "object",
            "null"
          ]
        },
        "audit_role_profile": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "audit_auditor": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "provider_id",
                "model_id"
              ],
              "properties": {
                "provider_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "model_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "audit_inventory_digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "reserved"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "spent": {
                "const": false
              },
              "refunded": {
                "const": false
              },
              "native_id": {
                "type": "null"
              },
              "first_terminal_fingerprint": {
                "type": "null"
              }
            },
            "required": [
              "spent",
              "refunded",
              "native_id",
              "first_terminal_fingerprint"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "launch_rejected"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "spent": {
                "const": false
              },
              "refunded": {
                "const": true
              },
              "native_id": {
                "type": "null"
              },
              "first_terminal_fingerprint": {
                "$ref": "#/$defs/digest256"
              }
            },
            "required": [
              "spent",
              "refunded",
              "native_id",
              "first_terminal_fingerprint"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "launching",
                  "pending"
                ]
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "spent": {
                "const": true
              },
              "refunded": {
                "const": false
              },
              "native_id": {
                "type": "string",
                "minLength": 1
              },
              "first_terminal_fingerprint": {
                "type": "null"
              }
            },
            "required": [
              "spent",
              "refunded",
              "native_id",
              "first_terminal_fingerprint"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "completed",
                  "failed",
                  "cancelled",
                  "timed_out",
                  "orphaned"
                ]
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "spent": {
                "const": true
              },
              "refunded": {
                "const": false
              },
              "native_id": {
                "type": "string",
                "minLength": 1
              },
              "first_terminal_fingerprint": {
                "$ref": "#/$defs/digest256"
              }
            },
            "required": [
              "spent",
              "refunded",
              "native_id",
              "first_terminal_fingerprint"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "refunded": {
                "const": true
              }
            },
            "required": [
              "refunded"
            ]
          },
          "then": {
            "properties": {
              "state": {
                "const": "launch_rejected"
              },
              "spent": {
                "const": false
              }
            },
            "required": [
              "state",
              "spent"
            ]
          }
        }
      ]
    },
    "nullableDigest256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
