{
  "name": "@siffran/pi-plugins",
  "version": "1.0.0",
  "description": "Turnkey Pi packages for the Empirica evidence-convergence workflow and Methodologist formal reasoning router.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "pi.dev",
    "empirica",
    "methodologist",
    "siffran"
  ],
  "engines": {
    "node": ">=22.6.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "pi-subagents": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "pi-subagents": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-tui": "0.84.3",
    "@types/node": "^22.0.0",
    "jiti": "2.7.0",
    "pi-subagents": "0.50.0",
    "typescript": "^5.6.0"
  },
  "pi": {
    "extensions": [
      "./plugins/empirica/adapters/pi/src/index.ts",
      "./plugins/methodologist/adapters/pi/src/index.ts"
    ],
    "subagents": {
      "agents": [
        "./plugins/empirica/agents/pi"
      ]
    },
    "skills": [
      "./plugins/empirica/skills",
      "./plugins/methodologist/skills"
    ]
  }
}
