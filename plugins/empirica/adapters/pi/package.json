{
  "name": "@siffran/empirica-pi",
  "version": "0.1.0",
  "description": "Internal Empirica v2 Pi translation shell; distributed only through the repository-root package that bundles pi-subagents and the auditor role.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi",
    "pi-extension",
    "pi.dev",
    "empirica",
    "siffran",
    "convergence"
  ],
  "engines": {
    "node": ">=22.6.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "bridge.py",
    "private_bridge.py",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  }
}
