          "package": "pi-subagents",
          "version": "0.75.0",
          "reviewed": true,
          "owner_path": "/opt/pi-subagents/src/extension/index.js",
          "package_root": "/opt/pi-subagents",
          "preflight_path": "/opt/pi-subagents/src/api/preflight.js",
          "source": "/opt/pi-subagents/index.js"
        }
      },
      "expect": null,
      "why": "a reviewed version (it has a compat record) with every path inside the package root"
    },
