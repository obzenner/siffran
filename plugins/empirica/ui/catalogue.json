{
  "$description": "Closed lists the UI iterates over (CONVENTIONS 0.2: declarations over code). Pages import them; scripts/audit.mjs expands dynamic copy keys from them. `kinds`, `independence`, `control_modes` and `approvals` are observer-contract enums, held equal by tests/contract.test.mjs. `filters` are the view's filters (VIEW.md R5): a field filter (`of` run or claim) keeps the chosen values, from states.json (`domain`), another list here (`values`) or the data (project); a flag filter (`flag`) keeps the claims whose named field is set. Each filter's `control` says how it is drawn (chips, a select, a flag); `options: projects` takes its values from the data's projects, `copy` names the copy family that words a `values` list. `record_classes` are the observer's research-record classes (held equal to the run contract); `budgets` the run budgets shown; `legend_domains` the key's groups. `route` declares the navigation (below). `data_sources` are the server's sources (adapters/observer/server.py); `poll_ms` is how often the app asks whether the store changed. `gallery_other_domains` are the vocabularies the gallery shows in its step strip rather than as state rows.",
  "kinds": [
    "needs-experiment",
    "needs-decision",
    "ordinary"
  ],
  "independence": [
    "distinct",
    "mixed",
    "same_model",
    "unverified",
    "human_owned"
  ],
  "control_modes": [
    "deliberative",
    "auto"
  ],
  "approvals": [
    "pending",
    "approved",
    "revision_pending",
    "rejected"
  ],
  "tones": [
    "positive",
    "negative",
    "caution",
    "info",
    "human",
    "audit",
    "neutral"
  ],
  "gallery_sections": [
    "colours",
    "atoms",
    "molecules",
    "organisms"
  ],
  "gallery_state_domains": [
    "claim",
    "run",
    "audit",
    "diagnostic",
    "evidence",
    "review",
    "file",
    "verification",
    "route",
    "decision"
  ],
  "data_sources": [
    "store",
    "demo"
  ],
  "poll_ms": 3000,
  "filters": [
    {
      "id": "run-state",
      "of": "run",
      "field": "state",
      "domain": "run",
      "control": "chips"
    },
    {
      "id": "audit",
