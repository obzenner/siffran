  "picture": {
    "$description": "The picture's scale is bounded in screen pixels (VIEW.md): a mark (a run's or a claim's drawn size, outline outside) is at least `mark_px.min` and at least `mark_label_ratio` times the text beside it; text is `text_px.min` to `text_px.max`; every mark has a transparent hit target of at least `target_px`. The topology scales within those bounds; a picture that does not fit at the smallest scale scrolls, and one smaller than its box is centred.",
    "mark_px": {
      "min": 11
    },
    "text_px": {
      "min": 11,
      "max": 16
    },
    "target_px": 24,
    "mark_label_ratio": 0.9
  },
  "gallery_other_domains": [
    "step",
    "outcome"
  ]
