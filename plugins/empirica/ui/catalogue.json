  "route": {
    "$description": "The selection as one value (app/route.js reads `levels` and `parent`) and every way of moving it. `levels` outermost first; `parent` is where Esc and the breadcrumb lead; `marked` are the levels drawn as a mark in the view (focus returns to the nearest marked ancestor of what was left). `edges` is the table tests/browser.walk.mjs holds the app to: each is `from` a level (or none) by an `action` to a level; the walk also crawls every control in the panel and fails on any control whose move is not declared here. `inert` are the panel controls that move nothing: a disclosure (details, Show all) and a chip that only has a hint.",
    "levels": [
      "project",
      "run",
      "claim",
      "step",
      "file"
    ],
    "parent": {
      "project": "none",
      "run": "project",
      "claim": "run",
      "step": "run",
      "file": "run"
    },
    "edges": [
      {
