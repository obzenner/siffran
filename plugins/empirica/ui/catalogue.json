      "options": "projects"
    },
    {
      "id": "claim-state",
      "of": "claim",
      "field": "state",
      "domain": "claim",
      "control": "chips"
    },
    {
      "id": "kind",
      "of": "claim",
      "field": "kind",
      "values": "kinds",
      "control": "chips",
      "copy": "kind"
    },
    {
      "id": "evidence",
      "of": "claim",
      "field": "evidence",
      "domain": "evidence",
      "control": "chips"
    },
    {
      "id": "review",
      "of": "claim",
      "field": "review",
      "domain": "review",
      "control": "chips"
    },
    {
      "id": "blocks",
      "of": "claim",
      "flag": "blocker",
      "control": "flag"
    }
  ],
  "record_classes": [
    "verbatim",
    "retrievable",
    "observed"
  ],
  "budgets": [
    "passes",
    "spawns",
