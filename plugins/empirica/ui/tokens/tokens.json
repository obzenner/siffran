  "font": {
    "$type": "fontFamily",
    "$description": "One family, IBM Plex Mono, for every word and number (sans is the same stack, so every class reads it): letter distinctness (I/l/1, O/0), tabular figures, and one advance (0.6 em) that the Universe's label widths compute from (catalogue universe *_char_px).",
    "sans": {
      "$value": [
        "IBM Plex Mono",
        "ui-monospace",
        "Menlo",
        "monospace"
      ]
    },
    "mono": {
      "$value": [
        "IBM Plex Mono",
        "ui-monospace",
        "Menlo",
        "monospace"
      ]
    }
  },
  "width": {
    "$description": "Content measures (max widths), the panes' widths (the rail, the sheet) and a row's fixed columns (its project and its time, so every row of a list puts them at one edge: the alignment invariants in tests/browser.journeys.mjs).",
