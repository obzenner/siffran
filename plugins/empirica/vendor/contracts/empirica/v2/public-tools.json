{
  "protocol": "empirica/v2",
  "schemas": {
    "host_handle": {
      "empirica_observe": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "description": "One schema-validated public author action for this run.",
            "oneOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "graph"
                  },
                  "payload": {
                    "description": "Extensible deep graph/evidence/actor domain data; only this object may carry D6-validated payload. The control object itself is closed.",
                    "type": "object"
                  }
                },
                "required": [
                  "kind"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "claim_id": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "kind": {
                    "const": "research"
                  },
                  "payload": {
                    "additionalProperties": false,
                    "properties": {
                      "citation": {
                        "minLength": 1,
                        "type": "string"
                      },
                      "observed_content_digest": {
                        "pattern": "^sha256:[0-9a-f]{64}$",
                        "type": "string"
                      },
                      "source_ref": {
                        "minLength": 1,
                        "type": "string"
                      }
                    },
                    "required": [
                      "source_ref",
                      "citation"
                    ],
                    "type": "object"
                  },
                  "result": {
                    "enum": [
                      "supports",
                      "refutes"
                    ]
                  },
                  "source_kind": {
                    "enum": [
                      "docs",
                      "code",
                      "runtime",
                      "web"
                    ]
                  }
                },
                "required": [
                  "kind",
                  "claim_id",
                  "source_kind",
                  "result",
                  "payload"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "claim_id": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "command": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "dependent_files": {
                    "items": {
                      "minLength": 1,
                      "pattern": "^[^/].*$",
                      "type": "string"
                    },
                    "minItems": 1,
                    "type": "array",
                    "uniqueItems": true
                  },
                  "kind": {
                    "const": "spike_request"
                  }
                },
                "required": [
                  "kind",
                  "claim_id",
                  "command",
                  "dependent_files"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "anyOf": [
                  {
                    "required": [
                      "budgets"
                    ]
                  },
                  {
                    "required": [
                      "modes"
                    ]
                  }
                ],
                "properties": {
                  "budgets": {
                    "additionalProperties": false,
                    "properties": {
                      "max_audit_spawns": {
                        "minimum": 0,
                        "type": "integer"
                      },
                      "max_passes": {
                        "minimum": 1,
                        "type": "integer"
                      },
                      "max_spawns": {
                        "minimum": 0,
                        "type": "integer"
                      }
                    },
                    "type": "object"
                  },
                  "kind": {
                    "const": "configure_run"
                  },
                  "modes": {
                    "additionalProperties": false,
                    "properties": {
                      "cli_exec": {
                        "type": "boolean"
                      },
                      "multi_provider": {
                        "type": "boolean"
                      }
                    },
                    "type": "object"
                  }
                },
                "required": [
                  "kind"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "route"
                  },
                  "reason": {
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "reason"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "investigate"
                  }
                },
                "required": [
                  "kind"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "freeze"
                  }
                },
                "required": [
                  "kind"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "claim_id": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "kind": {
                    "const": "dispatch"
                  },
                  "target": {
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "target"
                ],
                "type": "object"
              }
            ]
          }
        },
        "required": [
          "action"
        ],
        "type": "object"
      },
      "empirica_read": {
        "additionalProperties": false,
        "properties": {
          "operation": {
            "description": "Read the public run view, obtain the current audit argument, inspect the public contract, or restore a persisted run.",
            "enum": [
              "GetRun",
              "GetArgument",
              "GetContract",
              "RestoreRun"
            ]
          },
          "section_id": {
            "description": "Public contract section identifier when target is section.",
            "minLength": 1,
            "type": "string"
          },
          "target": {
            "description": "Contract projection for GetContract. Use section with section_id.",
            "enum": [
              "index",
              "section",
              "full"
            ]
          }
        },
        "required": [
          "operation"
        ],
        "type": "object"
      },
      "report_convergence": {
        "additionalProperties": false,
        "properties": {
          "intent": {
            "description": "Request convergence by default, or request an honest non-converged stop.",
            "enum": [
              "report_convergence",
              "stop"
            ]
          }
        },
        "required": [],
        "type": "object"
      }
    },
