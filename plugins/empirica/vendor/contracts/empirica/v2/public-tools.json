{
  "protocol": "empirica/v2",
  "schemas": {
    "model": {
      "empirica_read": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation"
        ],
        "properties": {
          "operation": {
            "enum": [
              "GetRun",
              "GetArgument",
              "GetContract",
              "RestoreRun"
            ],
            "description": "Read the public run view, obtain the current audit argument, inspect the public contract, or restore a persisted run."
          },
          "run_id": {
            "type": "string",
            "minLength": 1,
            "description": "Opaque identifier of the active Empirica run."
          },
          "target": {
            "enum": [
              "index",
              "section",
              "full"
            ],
            "description": "Contract projection for GetContract. Use section with section_id."
          },
          "section_id": {
            "type": "string",
            "minLength": 1,
            "description": "Public contract section identifier when target is section."
          }
        }
      },
      "empirica_observe": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "run_id",
          "action"
        ],
        "properties": {
          "run_id": {
            "type": "string",
            "minLength": 1,
            "description": "Opaque identifier of the active Empirica run."
          },
          "action": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": {
                    "const": "graph"
                  },
                  "payload": {
                    "type": "object",
                    "description": "Extensible deep graph/evidence/actor domain data; only this object may carry D6-validated payload. The control object itself is closed."
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "claim_id",
                  "source_kind",
                  "result",
                  "payload"
                ],
                "properties": {
                  "kind": {
                    "const": "research"
                  },
                  "claim_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "source_kind": {
                    "enum": [
                      "docs",
                      "code",
                      "runtime",
                      "web"
                    ]
                  },
                  "result": {
                    "enum": [
                      "supports",
                      "refutes"
                    ]
                  },
                  "payload": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "source_ref",
                      "citation"
                    ],
                    "properties": {
                      "source_ref": {
                        "type": "string",
                        "minLength": 1
                      },
                      "citation": {
                        "type": "string",
                        "minLength": 1
                      },
                      "observed_content_digest": {
                        "type": "string",
                        "pattern": "^sha256:[0-9a-f]{64}$"
                      }
                    }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "claim_id",
                  "command",
                  "dependent_files"
                ],
                "properties": {
                  "kind": {
                    "const": "spike_request"
                  },
                  "claim_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "command": {
                    "type": "string",
                    "minLength": 1
                  },
                  "dependent_files": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[^/].*$"
                    }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": {
                    "const": "configure_run"
                  },
                  "budgets": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "max_passes": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 1024
                      },
                      "max_spawns": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 128
                      },
                      "max_audit_spawns": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 128
                      }
                    }
                  },
                  "modes": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "multi_provider": {
                        "type": "boolean"
                      },
                      "cli_exec": {
                        "type": "boolean"
                      }
                    }
                  },
                  "auditor": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "provider_id",
                      "model_id"
                    ],
                    "properties": {
                      "provider_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "model_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      }
                    }
                  },
                  "allow_same_model": {
                    "type": "boolean"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "reason"
                ],
                "properties": {
                  "kind": {
                    "const": "route"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": {
                    "const": "investigate"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": {
                    "const": "freeze"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "target"
                ],
                "properties": {
                  "kind": {
                    "const": "dispatch"
                  },
                  "target": {
                    "type": "string",
                    "minLength": 1
                  },
                  "claim_id": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            ],
            "description": "One schema-validated public author action for this run."
          }
        }
      },
      "report_convergence": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "run_id"
        ],
        "properties": {
          "run_id": {
            "type": "string",
            "minLength": 1,
            "description": "Opaque identifier of the active Empirica run."
          },
          "intent": {
            "enum": [
              "report_convergence",
              "stop"
            ],
            "description": "Request convergence by default, or request an honest non-converged stop."
          }
        }
      }
    },
    "host_handle": {
      "empirica_read": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation"
        ],
        "properties": {
          "operation": {
