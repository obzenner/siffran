{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://siffran.dev/contracts/empirica/v2/state.schema.json",
  "title": "Empirica v2 internal persisted run state",
  "description": "Internal host-neutral persisted-state schema (D6 strict-v2-subtraction section 4). Not PublicContract behavior. Closed required fields with no decoder defaults; status and child-state vocabularies are mechanically mirrored from the canonical PublicContract registry. Procedural invariants (counter bounds, stamp bounds, child_id uniqueness) are owned by the codec and the contract validator, not by this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "state_schema",
    "spike_backend",
    "goal",
    "invocation",
    "status",
    "budgets",
    "selected_graph_artifact_id",
    "frozen_claim_ids",
    "frozen_semantic_digest",
    "route_stamp",
    "investigation_stamp",
    "stamp_seq",
    "last_derivation_digest",
    "children",
    "observation_basis_digest",
    "committed_artifact_head_id",
    "governance",
    "environment",
    "environment_history",
    "qualification_attempts"
  ],
  "properties": {
    "protocol": {
      "const": "empirica/v2"
    },
    "state_schema": {
      "const": "empirica.run/5"
    },
    "spike_backend": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "backend",
            "profile_id",
            "qualification_record_digest",
            "execution_binding_digest"
          ],
          "properties": {
            "kind": {
              "const": "qualified"
            },
            "backend": {
              "const": "docker"
            },
            "profile_id": {
              "enum": [
                "docker-isolated-v1",
                "docker-networked-v1"
              ]
            },
            "qualification_record_digest": {
              "$ref": "#/$defs/digest256"
            },
            "execution_binding_digest": {
              "$ref": "#/$defs/digest256"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "spikes_unavailable"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "unqualified"
            }
          }
        }
      ]
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "invocation": {
      "$ref": "#/$defs/invocationProvenance"
    },
    "status": {
      "enum": [
        "active",
        "converged",
        "stopped_residual",
        "stopped_frozen",
        "stopped_budget"
      ]
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_passes",
        "passes_used",
        "max_spawns",
        "spawns_used",
        "max_audit_spawns",
        "audit_spawns_used"
      ],
      "properties": {
        "max_passes": {
          "type": "integer",
          "minimum": 1
        },
        "passes_used": {
          "type": "integer",
          "minimum": 0
        },
        "max_spawns": {
          "type": "integer",
          "minimum": 0
        },
        "spawns_used": {
          "type": "integer",
          "minimum": 0
        },
        "max_audit_spawns": {
          "type": "integer",
          "minimum": 0
        },
        "audit_spawns_used": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "selected_graph_artifact_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "frozen_claim_ids": {
      "type": [
        "null",
        "array"
      ],
      "items": {
        "$ref": "#/$defs/claimId"
      },
      "uniqueItems": true
    },
    "frozen_semantic_digest": {
      "$ref": "#/$defs/nullableDigest256"
    },
    "route_stamp": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "investigation_stamp": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "stamp_seq": {
      "type": "integer",
      "minimum": 0
    },
    "last_derivation_digest": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "children": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/childRecord"
      }
    },
    "observation_basis_digest": {
      "$ref": "#/$defs/digest256",
      "description": "Content digest of the observation-basis event referenced by the latest committed transaction manifest."
    },
    "committed_artifact_head_id": {
      "$ref": "#/$defs/nullableDigest256"
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "control_mode",
        "plan_revision",
        "approved_digest",
        "approval_kind",
        "proposal_digest",
        "proposal",
        "context",
        "delegation_envelope",
        "receipts",
        "first_approval",
        "pre_approval_revisions",
        "post_approval_revisions"
      ],
      "properties": {
        "state": {
          "enum": [
            "pending",
            "approved",
            "revision_pending",
            "rejected"
          ]
        },
        "control_mode": {
          "enum": [
            "deliberative",
            "auto"
          ]
        },
        "plan_revision": {
          "type": "integer",
          "minimum": 0
        },
        "approved_digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "approval_kind": {
          "enum": [
            null,
            "host_ui",
            "auto"
          ]
        },
        "proposal_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "proposal": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "budgets",
            "rationale"
          ],
          "properties": {
            "budgets": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "max_passes",
                "max_spawns",
                "max_audit_spawns"
              ],
              "properties": {
                "max_passes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1024
                },
                "max_spawns": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 128
                },
                "max_audit_spawns": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 128
                }
              }
            },
            "rationale": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 600,
                  "pattern": "\\S"
                }
              ],
              "description": "Author sizing rationale (null for the unapprovable StartRun placeholder)."
            }
          }
        },
        "context": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "author",
            "ingress",
            "approval_capability",
            "delegation",
            "interactive"
          ],
          "properties": {
            "author": {
              "anyOf": [
                {
                  "$ref": "#/$defs/identityObservation",
                  "unevaluatedProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "ingress": {
              "enum": [
                "unavailable",
                "mcp_elicitation",
                "pi_ui"
              ]
            },
            "approval_capability": {
              "enum": [
                "unavailable",
                "human_configuration"
              ]
            },
            "delegation": {
              "type": "boolean",
              "description": "Operator-recorded delegation provenance admitted as a neutral fact."
            },
            "interactive": {
              "type": [
                "boolean",
                "null"
              ],
              "description": "Interactive invocation provenance admitted as a neutral fact."
            }
          }
        },
        "delegation_envelope": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "max_passes",
                "max_spawns",
                "max_audit_spawns"
              ],
              "properties": {
                "max_passes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 8
                },
                "max_spawns": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1
                },
                "max_audit_spawns": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2
                }
              }
            }
          ],
          "description": "Durable componentwise-narrowed delegated-auto authority envelope; null outside delegated auto."
        },
        "first_approval": {
          "type": "boolean",
          "description": "Durable fact: whether this run has had a first successful approval; never inferred from revision, pending state, or latest approval kind."
        },
        "pre_approval_revisions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "post_approval_revisions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "receipts": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "fingerprint",
              "presentation_fingerprint",
              "outcome",
              "plan_revision",
              "proposal_digest",
              "approval_kind",
              "superseded_budgets",
              "document_digest"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "fingerprint": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "presentation_fingerprint": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "outcome": {
                "enum": [
                  "approve",
                  "amend",
                  "reject",
                  "dismiss",
                  "present"
                ]
              },
              "plan_revision": {
                "type": "integer",
                "minimum": 0
              },
              "proposal_digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$",
                "description": "Immutable exact proposal binding for this receipt."
              },
              "approval_kind": {
                "enum": [
                  "host_ui",
                  "auto"
                ],
                "description": "Immutable per-receipt approval kind; host_ui requires a prior exact presentation, auto has none."
              },
              "superseded_budgets": {
                "description": "The ceilings of the proposal this amendment superseded, recorded at the amend commit: the revise erases them from the run's state, so the confirm form's (was ...) priors cannot be derived later (ADR-0072). Null for every other outcome; an amend receipt always names the revision before the one it brought about.",
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "max_passes",
                      "max_spawns",
                      "max_audit_spawns"
                    ],
                    "properties": {
                      "max_passes": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "max_spawns": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "max_audit_spawns": {
                        "type": "integer",
                        "minimum": 0
                      }
                    }
                  }
                ]
              },
              "document_digest": {
                "description": "The immutable HITL document this receipt's decision was shown against (ADR-0072, PR 07; conditioned on the approval kind since PR 13): every host_ui receipt names the sha256 of exactly the bytes the core rendered — verified against the state's own recomputation before the receipt was written, so a present bound to another state's document never records anything — and every auto receipt records null: auto answers no human's question. A finalizing decision must name the document its own present receipt recorded.",
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "approval_kind": {
                      "const": "host_ui"
                    }
                  },
                  "required": [
                    "approval_kind"
                  ]
                },
                "then": {
                  "properties": {
                    "document_digest": {
                      "type": "string",
                      "pattern": "^sha256:[0-9a-f]{64}$"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "approval_kind": {
                      "const": "auto"
                    }
                  },
                  "required": [
                    "approval_kind"
                  ]
                },
                "then": {
                  "properties": {
                    "document_digest": {
                      "type": "null"
                    }
                  }
                }
              }
            ]
          }
        }
      }
    },
    "environment": {
      "x-core-validator": "core.run.validate_environment",
      "description": "The run's latest environment proposal revision; null while none exists. Earlier revisions are immutable history in environment_history.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/environmentMember"
        }
      ]
    },
    "environment_history": {
      "x-core-validator": "core.run.validate_environment_history",
      "description": "Immutable earlier environment revisions; the latest lives in environment.",
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/environmentMember"
      }
    },
    "qualification_attempts": {
      "x-core-validator": "core.run.validate_qualification_attempts",
      "description": "Append-only host qualification attempts; the sequence number is derived, never stored.",
      "type": "array",
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/qualificationAttempt"
      }
    }
  },
  "$defs": {
    "digest256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "childRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "child_id",
        "purpose",
        "resource_class",
        "state",
        "spent",
        "refunded",
        "deadline",
        "native_id",
        "first_terminal_fingerprint",
        "capability_ref",
        "audit_operation_id",
        "audit_argument",
        "audit_role_profile"
      ],
      "properties": {
        "child_id": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "resource_class": {
          "enum": [
            "investigation",
            "audit"
          ]
        },
        "state": {
          "enum": [
            "reserved",
            "launching",
            "pending",
            "completed",
            "launch_rejected",
            "failed",
            "cancelled",
            "timed_out",
            "orphaned"
          ]
        },
        "spent": {
          "type": "boolean"
        },
        "refunded": {
          "type": "boolean"
        },
        "deadline": {
          "type": [
            "number",
            "null"
          ]
        },
        "native_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "first_terminal_fingerprint": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "capability_ref": {
          "type": "string",
          "minLength": 1
        },
        "audit_operation_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/digest256"
            },
            {
              "type": "null"
            }
          ]
        },
        "audit_argument": {
          "type": [
            "object",
            "null"
          ]
        },
        "audit_role_profile": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "reserved"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "spent": {
                "const": false
              },
              "refunded": {
                "const": false
              },
              "native_id": {
                "type": "null"
              },
              "first_terminal_fingerprint": {
                "type": "null"
              }
            },
            "required": [
              "spent",
              "refunded",
              "native_id",
              "first_terminal_fingerprint"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "launch_rejected"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "spent": {
                "const": false
              },
              "refunded": {
                "const": true
              },
              "native_id": {
                "type": "null"
              },
              "first_terminal_fingerprint": {
                "$ref": "#/$defs/digest256"
              }
            },
            "required": [
              "spent",
              "refunded",
              "native_id",
              "first_terminal_fingerprint"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "launching",
                  "pending"
                ]
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "spent": {
                "const": true
              },
              "refunded": {
                "const": false
              },
              "native_id": {
                "type": "string",
                "minLength": 1
              },
              "first_terminal_fingerprint": {
                "type": "null"
              }
            },
            "required": [
              "spent",
              "refunded",
              "native_id",
              "first_terminal_fingerprint"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "completed",
                  "failed",
                  "cancelled",
                  "timed_out",
                  "orphaned"
                ]
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "spent": {
                "const": true
              },
              "refunded": {
                "const": false
              },
              "native_id": {
                "type": "string",
                "minLength": 1
              },
              "first_terminal_fingerprint": {
                "$ref": "#/$defs/digest256"
              }
            },
            "required": [
              "spent",
              "refunded",
              "native_id",
              "first_terminal_fingerprint"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "refunded": {
                "const": true
              }
            },
            "required": [
              "refunded"
            ]
          },
          "then": {
            "properties": {
              "state": {
                "const": "launch_rejected"
              },
              "spent": {
                "const": false
              }
            },
            "required": [
              "state",
              "spent"
            ]
          }
        }
      ]
    },
    "nullableDigest256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "invocationProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "interactive",
        "signal",
        "delegation",
        "audit_retrieval",
        "human_surface"
      ],
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1
        },
        "interactive": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "signal": {
          "type": "string",
          "minLength": 1
        },
        "delegation": {
          "type": "boolean"
        },
        "host_runtime": {
          "description": "Optional host-observed facts about the runtime that executes this host's foreground audit, recorded once with the run (Pi: the pi-subagents owner). Validated at the application boundary against the host profile's subagents_compatibility range, persisted opaquely, and read by the core only for `reviewed` (a version with no checked-in compat record is recorded `reviewed: false` and shown in the run view; it is admitted by what the adapter observed of it, ADR-0069).",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "policy_id",
            "subagents"
          ],
          "properties": {
            "policy_id": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*-v[0-9]+$"
            },
            "subagents": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "package",
                "version",
                "owner_path",
                "package_root",
                "preflight_path",
                "source"
              ],
              "properties": {
                "package": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9._-]*$"
                },
                "version": {
                  "type": "string",
                  "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
                },
                "owner_path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "package_root": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "preflight_path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "source": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "reviewed": {
                  "type": "boolean",
                  "description": "Whether this exact version has a checked-in compat record. false is admitted when the live preflight and the tool's parameter schema passed; it is never a refusal by itself. An absent value reads as false (not reviewed); a present value that is not a boolean is malformed."
                }
              }
            }
          }
        },
        "session": {
          "description": "Optional host-observed fact: where this run's session can be found again, recorded once at StartRun by the host from what it observed (Claude: the hook payload's session_id and transcript_path; Pi: the session manager's id and session file). The author has no StartRun and cannot supply or change it. Absent when the host observed nothing: it reads as unknown, never as a guess.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label",
            "locator"
          ],
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "description": "A short human name for the session (its id)."
            },
            "locator": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "description": "A copyable path or id that finds the session again: its transcript or session file when the host has one, otherwise its id."
            }
          }
        },
        "audit_retrieval": {
          "description": "The retrieval kinds this host's auditor is observed to cover, recorded once at StartRun and re-observed at audit launch (a divergence refuses the launch). workspace: files inside the workspace; local: absolute or home paths; web: http(s) URLs. A research record of any other kind is confirmed by a human (ADR-0067).",
          "type": "array",
          "items": {
            "enum": [
              "local",
              "web",
              "workspace"
            ]
          },
          "uniqueItems": true
        },
        "human_surface": {
