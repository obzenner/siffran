{
  "name": "@siffran/methodologist-pi",
  "version": "0.10.1",
  "description": "Turnkey Pi package (Pi >=1.0.0,<2.0.0) for Methodologist: bare /think presents the complete registry catalog and starts the human-selected methodology; named and --simple expert paths remain available.",
  "type": "module",
  "license": "LicenseRef-PolyForm-Internal-Use-1.0.0",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "pi.dev",
    "methodologist",
    "siffran",
    "reasoning"
  ],
  "engines": {
    "node": ">=22.6.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "pi": {
    "extensions": [
      "./adapters/pi/src/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "exports": {
    ".": "./adapters/pi/src/index.ts"
  },
  "files": [
    "adapters/bridge.py",
    "adapters/pi/bridge.py",
    "adapters/pi/README.md",
    "adapters/pi/src",
    "application.py",
    "core/*.py",
    "skills"
  ],
  "scripts": {
    "test": "node --test adapters/pi/test/*.test.ts",
    "typecheck": "tsc -p adapters/pi/tsconfig.json --noEmit"
  }
}
